{
  "name": "baselinewatch",
  "version": "0.36.0",
  "private": true,
  "description": "Security news, CVEs and advisories in one timeline, plus a change register for the standards themselves.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "fetch": "node --disable-warning=ExperimentalWarning src/cli.ts fetch",
    "backfill": "node --disable-warning=ExperimentalWarning src/cli.ts backfill",
    "relink": "node --disable-warning=ExperimentalWarning src/cli.ts relink",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts public",
    "check:manifest": "node scripts/validate-manifest.mjs",
    "check:feeds": "node --disable-warning=ExperimentalWarning scripts/probe-feeds.mjs",
    "check": "npm run typecheck && npm run test && npm run lint && npm run check:manifest"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
